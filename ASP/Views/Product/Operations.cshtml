@using ASP.Controllers
@model TwoLists 
@{
    ViewData["Title"] = "История операций";
}   

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-journal-text text-primary"></i> История складских операций</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> К списку товаров
    </a>
</div>

<!-- Таблица логов транзакций -->
<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th class="text-center" style="width: 30%;">Товар</th>
                <th class="text-center" style="width: 25%;">Дата и время</th>
                <th class="text-center" style="width: 20%;">Количество</th>
                <th class="text-center" style="width: 25%;">Тип операции</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Operations == null || !Model.Operations.Any())
            {
                <tr>
                    <td colspan="4" class="text-center py-4 text-secondary">
                        <i class="bi bi-journal-x fs-2 d-block mb-2"></i>
                        История складских операций пуста
                    </td>
                </tr>
            }
            else
            {
                // Выводим операции в обратном хронологическом порядке (последние сверху)
                foreach (var operation in Model.Operations.OrderByDescending(x => x.Date))
                {
                    bool isImport = operation.OperationType == "Import";
                    <tr>
                        <!-- Название товара -->
                        <td class="text-center font-weight-bold">
                            @(Model.Items.Find(x => x.IdItem == operation.IdItem)?.Name ?? $"Удаленный товар (ID: {operation.IdItem})")
                        </td>
                        
                        <!-- Дата операции -->
                        <td class="text-center text-muted">
                            @operation.Date.ToString("dd.MM.yyyy HH:mm:ss")
                        </td>
                        
                        <!-- Количество (со знаком + или -) -->
                        <td class="text-center font-weight-bold @(isImport ? "text-success" : "text-danger")">
                            @(isImport ? "+" : "-")@operation.QuantityChange
                        </td>
                        
                        <!-- Бейдж типа операции -->
                        <td class="text-center">
                            @if (isImport)
                            {
                                <span class="badge badge-import">
                                    <i class="bi bi-box-arrow-in-down"></i> Приход (Импорт)
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-export">
                                    <i class="bi bi-box-arrow-up"></i> Расход (Экспорт)
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>