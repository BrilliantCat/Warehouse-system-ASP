<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Система Склада</title>
    <!-- Подключаем Bootstrap из локальных библиотек -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Подключаем Bootstrap Icons для иконок -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Подключаем наш кастомный премиальный стиль -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ASP.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!-- Навигационная панель со светлым дизайном -->
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom mb-4">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Product" asp-action="Index">
                    <i class="bi bi-box-seam text-primary"></i>
                    <span>Система Склада</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
                               asp-area="" asp-controller="Product" asp-action="Index">
                                <i class="bi bi-list-task"></i> Товары
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" && ViewContext.RouteData.Values["action"]?.ToString() == "NewItem" ? "active" : "")" 
                               asp-area="" asp-controller="Product" asp-action="NewItem">
                                <i class="bi bi-plus-circle"></i> Добавить товар
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" && ViewContext.RouteData.Values["action"]?.ToString() == "Operations" ? "active" : "")" 
                               asp-area="" asp-controller="Product" asp-action="Operations">
                                <i class="bi bi-journal-text"></i> История операций
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <!-- Контент страницы с анимацией появления -->
        <main role="main" class="pb-3 fade-in">
            @RenderBody()
        </main>
    </div>

    <!-- Футер -->
    <footer class="border-top footer text-muted text-center">
        <div class="container">
            &copy; 2026 - Система Склада ASP.NET Core - Разработано для коммерческого использования
        </div>
    </footer>

    <!-- Подключаем jQuery и Bootstrap скрипты -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
